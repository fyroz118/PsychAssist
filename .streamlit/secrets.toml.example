# Copy to secrets.toml, fill in, and DELETE this example from git.
# Leave any section out and the corresponding feature stays OFF.

# 23 - authentication (optional)
[auth]
password = "change-me"
# Or per-user:
# [auth.users]
# alice = "alice-password"
# bob   = "bob-password"

# 25 - encryption of handwritten notes at rest (optional)
[encryption]
# Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
key = "REPLACE_WITH_FERNET_KEY"

# 17 - Postgres / Supabase (optional; SQLite used if absent)
[database]
url = "postgresql://user:pass@host:5432/dbname"